{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the deployed Worker name. The live Worker serving
  // villagestrongfoundation.org and www is `village-strong`; a different name
  // here makes Wrangler create a second Worker instead of updating this one.
  "name": "village-strong",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],

  // `assets.directory` is generated by the Cloudflare Vite plugin into
  // dist/client at build time. Only the binding name must be declared here:
  // worker/index.ts serves the /_vinext/image endpoint through env.ASSETS, and
  // without this binding that route throws at runtime.
  "assets": {
    "binding": "ASSETS"
  },

  // Cloudflare Images backs the vinext image optimizer. worker/index.ts reads
  // env.IMAGES on the /_vinext/image path, so the binding is kept even though
  // no page currently requests that route; the app serves plain <img> tags.
  // This is a paid product. Removing the binding would also require deleting
  // the /_vinext/image branch from worker/index.ts. See CLOUDFLARE.md.
  "images": {
    "binding": "IMAGES"
  },

  // Workers Logs. Required for `wrangler tail` and the Cloudflare dashboard
  // log view in production.
  "observability": {
    "enabled": true
  },

  // Custom domains. villagestrongfoundation.org is an active zone in this
  // account (zone id e296a044e112b01e77f14496a97339ee), so Wrangler provisions
  // the DNS record and TLS certificate on deploy. Both the apex and www serve
  // this Worker; see CLOUDFLARE.md to make www a redirect to the apex instead.
  "routes": [
    { "pattern": "villagestrongfoundation.org", "custom_domain": true },
    { "pattern": "www.villagestrongfoundation.org", "custom_domain": true }
  ]

  // `account_id` is deliberately not hardcoded. Local deploys authenticate via
  // `wrangler login`; CI supplies CLOUDFLARE_ACCOUNT_ID from the repository
  // secret of the same name. See CLOUDFLARE.md.
}
