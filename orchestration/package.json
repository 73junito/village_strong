{
  "name": "village-strong-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "check:private-config": "wrangler deploy --config wrangler.jsonc --dry-run",
    "cf:types": "wrangler types env.d.ts",
    "review": "node scripts/review.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.integration.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tests/*.test.ts",
    "test:integration": "vitest run",
    "check": "npm run cf:types && npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "agents": "0.28.0",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@types/node": "^26.6.5",
    "typescript": "7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "undici": "7.29.1",
    "sharp": "0.35.5",
    "agents": {
      "@modelcontextprotocol/client": "2.3.1",
      "@modelcontextprotocol/sdk": "1.31.0"
    }
  }
}
