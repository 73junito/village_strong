{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // Runtime types are generated by `wrangler types env.d.ts` (see the
    // `cf:types` script) and supersede @cloudflare/workers-types, which Wrangler
    // explicitly tells you to uninstall. Regenerate after editing
    // wrangler.jsonc, or the Env bindings below will drift from the real config.
    "types": [],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // `moduleDetection` is deliberately left at "auto". Forcing it makes
    // TypeScript treat env.d.ts as a module, which drops the generated global
    // declarations (Env, DurableObjectNamespace, ExportedHandler, the
    // cloudflare:workers modules) and produces a wall of "cannot find name"
    // errors. Every file in this project is already a module by virtue of its
    // imports and exports, so the flag bought nothing.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["env.d.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "tests"]
}